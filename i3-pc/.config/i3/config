set $mod Mod4
set $alt Mod1
set $commands ~/.config/i3/commands

font pango:monospace 12

floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

mode "resize" {
	bindsym Left resize shrink width 5 px or 5 ppt
	bindsym Down resize grow height 5 px or 5 ppt
	bindsym Up resize shrink height 5 px or 5 ppt
	bindsym Right resize grow width 5 px or 5 ppt

	bindsym Return mode "default"
	bindsym Escape mode "default"
	bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

gaps inner 10
smart_gaps on
for_window [class=".*"] border pixel 4

bindsym Print exec --no-startup-id $commands/fixed-flameshot
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
bindsym $mod+Return exec --no-startup-id i3-sensible-terminal
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+i exec --no-startup-id $commands/search-projects
bindsym $mod+n exec mousepad
bindsym $mod+F1 exec google-chrome-stable --profile-directory="Default"
bindsym $mod+F2 exec code ~/.config/i3/config
bindsym $mod+F3 exec google-chrome-stable --profile-directory="Profile 1" --app=https://music.youtube.com
bindsym $mod+F4 exec google-chrome-stable --profile-directory="Default" --app=https://youtube.com
bindsym $mod+F5 exec thunar
bindsym $mod+F6 exec google-chrome-stable --profile-directory="Default" --app=https://devdocs.io/
bindsym $mod+F12 exec $commands/aswitch2
bindsym $mod+Shift+F12 exec $commands/aswitch3
bindsym $mod+Escape kill
bindsym $mod+g exec google-chrome-stable --profile-directory="Default" --app=https://gemini.google.com/app?hl=es
bindsym $mod+Shift+p exec poweroff
bindsym $mod+$alt+Shift+p exec reboot
bindsym $mod+plus exec kmag
bindsym $mod+m exec --no-startup-id $commands/keypress/run
bindsym $mod+Tab exec $commands/show-windows
bindsym $mod+Shift+w exec google-chrome-stable --profile-directory="Default" --app=https://web.whatsapp.com/
bindsym $mod+Delete exec --no-startup-id $commands/kill
bindsym $mod+Shift+d exec $commands/drun
bindsym $mod+Shift+h exec $commands/fish-history
bindsym $mod+Shift+y exec --no-startup-id ~/.config/polybar/launch.sh
bindsym Scroll_Lock exec --no-startup-id $commands/lock
bindsym $mod+l exec --no-startup-id $commands/lock
bindsym $mod+b exec blueman-manager
bindsym $mod+Shift+b exec --no-startup-id $commands/connect_sony_headphones.sh
bindsym $mod+Shift+$alt+b --no-startup-id exec $commands/rofi_bluetooth.sh
bindsym $mod+apostrophe exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+exclamdown exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%

# exec --no-startup-id streamdeck -n
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id nitrogen --restore
exec --no-startup-id redshift -c ~/.config/redshift/redshift.conf
exec --no-startup-id clipit
exec --no-startup-id flameshot
exec --no-startup-id pasystray
exec --no-startup-id udiskie --tray
exec --no-startup-id dunst
exec --no-startup-id xscreensaver --no-splash
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id fusuma
exec --no-startup-id /usr/bin/octopi-notifier
exec --no-startup-id ~/fix
exec --no-startup-id conky -c ~/.config/conky/conky.conf
exec --no-startup-id /bin/sh -c 'dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3 XDG_SESSION_TYPE=x11 >/dev/null 2>&1 || true; eval "$(/usr/bin/gnome-keyring-daemon --start --components=secrets)"; dbus-update-activation-environment --systemd SSH_AUTH_SOCK GNOME_KEYRING_CONTROL GNOME_KEYRING_PID >/dev/null 2>&1 || true'
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id xrandr --output DP-4 --mode 3440x1440 --rate 74.98 --output DP-1 --mode 1920x1080 --rate 74.97
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

